# Copy this file to .env (local dev) and set the same variables in your
# Vercel/Netlify project settings for production. Nothing here is required
# for the site to run — every value has a safe fallback.

# --- TinaCMS (see EDITING.md) ---
# From your TinaCloud project settings, once created.
TINA_CLIENT_ID=
TINA_TOKEN=
TINA_BRANCH=main

# --- Form submissions (see src/lib/formSubmit.ts) ---
# The public FORM ACTION URL from your email provider's "embed a form" /
# "HTML form" export (MailerLite, ConvertKit, etc.) — NOT a secret API key.
# Leave blank to keep forms in stub mode (submissions are logged to the
# browser console instead of sent anywhere).
PUBLIC_FORM_ENDPOINT=

# --- The Answer Chat (planned — see docs/ANSWER-CHAT.md) ---
# Not used by the site yet. Server-side only when built — never prefix
# these with PUBLIC_, that would expose the key in the browser bundle.
# ANSWER_CHAT_API_KEY=
# ANSWER_CHAT_MODEL=
