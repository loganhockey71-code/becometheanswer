---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import globalSettings from '../../content/settings/global.json';

const { footer } = globalSettings;
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper">
  <div class="mx-auto flex w-full max-w-[1120px] flex-col gap-8 px-6 py-14 md:flex-row md:items-center md:justify-between">
    <a href="/" class="flex items-center gap-3">
      <Mark size={28} />
      <Wordmark class="text-base" />
    </a>

    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-muted">
      <a href="/aeo-glossary" class="hover:text-ink">AEO Glossary</a>
      <a href={footer.privacyHref} class="hover:text-ink">Privacy Policy</a>
      <a href={footer.termsHref} class="hover:text-ink">Terms of Service</a>
      <span>&copy; {year} Become the Answer</span>
    </div>
  </div>
</footer>
