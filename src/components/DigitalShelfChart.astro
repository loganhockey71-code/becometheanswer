---
// Native rebuild of the "Impact on the digital shelf" chart (source only existed
// as a print-PDF export, not a web-ready image). Visual is a simplified,
// honest reinterpretation of the same four data points — not a pixel copy —
// so it renders crisply at any size instead of embedding a rasterized PDF page.
// Bjorn's mockup used bespoke navy/teal/gray card colors; those aren't part of
// the site's brand palette (global.css), so the four buckets are told apart
// here using the existing ink/cloud/signal tokens instead, escalating visual
// weight toward the final, most urgent bucket.
interface Stage {
  value: string;
  label: string;
  note?: string;
}
interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  stages: Stage[];
  riskHeading?: string;
  riskBody?: string;
  source?: string;
}
const { eyebrow, heading, intro, stages, riskHeading, riskBody, source } = Astro.props;

const cardStyles = [
  'border-line bg-cloud text-ink',
  'border-ink bg-ink text-paper',
  'border-line bg-paper text-ink',
  'border-signal bg-signal text-ink',
];
---

<div>
  <p class="text-xs font-semibold uppercase tracking-[0.08em] text-signal-deep">{eyebrow}</p>
  <h2 class="mt-3 font-display text-[32px] font-bold text-ink md:text-[38px]">{heading}</h2>
  <p class="mt-4 max-w-prose text-lg text-slate">{intro}</p>

  <div class="mt-10 grid grid-cols-2 items-stretch gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] md:gap-4">
    {
      stages.map((stage, i) => (
        <div class="contents">
          <div
            class:list={[
              'flex flex-col justify-between rounded-[12px] border p-6',
              cardStyles[i] ?? cardStyles[0],
            ]}
          >
            <span class="font-display text-2xl font-bold md:text-3xl">{stage.value}</span>
            <span class="mt-3 text-sm opacity-90">{stage.label}</span>
            {stage.note && <span class="mt-1 text-xs opacity-70">{stage.note}</span>}
          </div>
          {i < stages.length - 1 && (
            <span
              class="hidden items-center justify-center font-display text-2xl font-bold text-signal md:flex"
              aria-hidden="true"
            >
              &rarr;
            </span>
          )}
        </div>
      ))
    }
  </div>

  {
    (riskHeading || riskBody) && (
      <div class="mt-6 rounded-[12px] bg-ink p-6 text-paper md:p-8">
        {riskHeading && (
          <p class="text-sm font-semibold uppercase tracking-[0.04em] text-signal">
            &#9888; {riskHeading}
          </p>
        )}
        {riskBody && <p class="mt-3 max-w-3xl text-line">{riskBody}</p>}
      </div>
    )
  }

  {source && <p class="mt-3 text-xs text-muted">Source: {source}</p>}
</div>
