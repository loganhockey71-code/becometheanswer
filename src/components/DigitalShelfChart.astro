---
// Native rebuild of the "Impact on the digital shelf" chart (source only existed
// as a print-PDF export, not a web-ready image). Visual is a simplified,
// honest reinterpretation of the same four data points — not a pixel copy —
// so it renders crisply at any size instead of embedding a rasterized PDF page.
interface Stage {
  value: string;
  label: string;
  note?: string;
}
interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  stages: Stage[];
}
const { eyebrow, heading, intro, stages } = Astro.props;
---

<div>
  <p class="text-xs font-semibold uppercase tracking-[0.08em] text-signal-deep">{eyebrow}</p>
  <h2 class="mt-3 font-display text-3xl font-bold text-ink md:text-4xl">{heading}</h2>
  <p class="mt-4 max-w-prose text-lg text-slate">{intro}</p>

  <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4">
    {
      stages.map((stage, i) => {
        const isLast = i === stages.length - 1;
        return (
          <div
            class:list={[
              'flex flex-col justify-between rounded-[12px] border p-6',
              isLast ? 'border-signal bg-signal-tint' : 'border-line bg-cloud',
            ]}
          >
            <span
              class:list={[
                'font-display text-2xl font-bold md:text-3xl',
                isLast ? 'text-signal-deep' : 'text-ink',
              ]}
            >
              {stage.value}
            </span>
            <span class="mt-3 text-sm text-slate">{stage.label}</span>
            {stage.note && <span class="mt-1 text-xs text-muted">{stage.note}</span>}
          </div>
        );
      })
    }
  </div>
</div>
