---
import Button from './Button.astro';

interface Item {
  title: string;
  oneLiner: string;
  ctaLabel: string;
  ctaHref?: string;
  // 'register' opens the site's main CTA1 form; any other string opens the
  // matching lead form (see src/lib/leadForms.ts); omit both to use ctaHref.
  formType?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
  {
    items.map((item) => (
      <div class="flex flex-col justify-between rounded-[12px] border border-line bg-paper p-6">
        <div>
          <h3 class="font-display text-xl font-bold text-ink">{item.title}</h3>
          <p class="mt-2 text-sm text-slate">{item.oneLiner}</p>
        </div>
        {item.formType === 'register' ? (
          <Button variant="link" openRegisterForm class="mt-4 self-start text-sm">
            {item.ctaLabel}
          </Button>
        ) : item.formType ? (
          <Button variant="link" openLeadForm={item.formType} class="mt-4 self-start text-sm">
            {item.ctaLabel}
          </Button>
        ) : (
          <Button variant="link" href={item.ctaHref} class="mt-4 self-start text-sm">
            {item.ctaLabel}
          </Button>
        )}
      </div>
    ))
  }
</div>
