---
import Button from './Button.astro';

interface Item {
  title: string;
  oneLiner: string;
  ctaLabel: string;
  ctaHref?: string;
  // 'register' opens the site's main CTA1 form; any other string opens the
  // matching lead form (see src/lib/leadForms.ts); omit both to use ctaHref.
  formType?: string;
}
interface Props {
  items: Item[];
  // Index of the card to visually feature with a dark/orange treatment
  // (per Bjorn's feedback mockup: the middle offer stands out).
  featuredIndex?: number;
}
const { items, featuredIndex } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
  {
    items.map((item, i) => {
      const isFeatured = i === featuredIndex;
      return (
        <div
          class:list={[
            'flex flex-col justify-between rounded-[12px] border p-6',
            isFeatured ? 'border-ink bg-ink text-paper' : 'border-line bg-paper text-ink',
          ]}
        >
          <div>
            <h3 class:list={['font-display text-[22px] font-bold', isFeatured ? 'text-paper' : 'text-ink']}>
              {item.title}
            </h3>
            <p class:list={['mt-2 text-sm', isFeatured ? 'text-line' : 'text-slate']}>{item.oneLiner}</p>
          </div>
          {item.formType === 'register' ? (
            <Button
              variant={isFeatured ? 'primary' : 'link'}
              openRegisterForm
              class={isFeatured ? 'mt-4 self-start text-sm' : 'mt-4 self-start text-sm'}
            >
              {item.ctaLabel}
            </Button>
          ) : item.formType ? (
            <Button variant={isFeatured ? 'primary' : 'link'} openLeadForm={item.formType} class="mt-4 self-start text-sm">
              {item.ctaLabel}
            </Button>
          ) : (
            <Button variant={isFeatured ? 'primary' : 'link'} href={item.ctaHref} class="mt-4 self-start text-sm">
              {item.ctaLabel}
            </Button>
          )}
        </div>
      );
    })
  }
</div>
