---
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<div class="grid grid-cols-2 gap-x-6 gap-y-8 border-y border-line py-10 sm:grid-cols-5">
  {
    stats.map((stat) => (
      <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
        <span class="font-display text-3xl font-bold text-signal sm:text-4xl">{stat.value}</span>
        <span class="mt-1 text-sm text-muted">{stat.label}</span>
      </div>
    ))
  }
</div>
