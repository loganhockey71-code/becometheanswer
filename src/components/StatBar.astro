---
interface Stat {
  value: string;
  label: string;
  sourceLabel?: string;
  sourceUrl?: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<div class="flex flex-wrap justify-center gap-x-12 gap-y-8 border-y border-line py-10 text-center">
  {
    stats.map((stat) => (
      <div class="flex max-w-[220px] flex-col items-center">
        <span class="font-display text-3xl font-bold text-signal sm:text-4xl">{stat.value}</span>
        <span class="mt-1 text-sm text-muted">{stat.label}</span>
        {stat.sourceLabel && (
          <span class="mt-2 text-xs text-muted">
            Source:{' '}
            {stat.sourceUrl ? (
              <a
                href={stat.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-2 hover:text-signal-deep"
              >
                {stat.sourceLabel}
              </a>
            ) : (
              stat.sourceLabel
            )}
          </span>
        )}
      </div>
    ))
  }
</div>
