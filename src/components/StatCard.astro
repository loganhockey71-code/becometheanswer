---
interface Props {
  stat: string;
  context: string;
  sourceLabel: string;
  sourceUrl: string;
}
const { stat, context, sourceLabel, sourceUrl } = Astro.props;
---

<div class="flex flex-col rounded-[12px] border border-line bg-cloud p-6">
  <span class="font-display text-4xl font-bold text-signal">{stat}</span>
  <p class="mt-3 text-sm text-slate">{context}</p>
  <a
    href={sourceUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 text-xs text-signal-deep underline underline-offset-4 hover:text-signal"
  >
    {sourceLabel}
  </a>
</div>
