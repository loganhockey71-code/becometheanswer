---
// Renders one modal per configured lead-form type (downloadChapter, preorder,
// downloadReport, masterclass, speaker, consultancy, connect). Any element
// anywhere on the site opens the right one via [data-open-lead-form="<id>"].
// Submission goes through src/lib/formSubmit.ts — a console.log stub until
// PUBLIC_FORM_ENDPOINT is configured, then a real POST to that endpoint.
import { LEAD_FORM_FIELDS, FIELD_DEFS } from '../lib/leadForms';
import globalSettings from '../../content/settings/global.json';

const copyById = globalSettings.leadForms as Record<
  string,
  { heading: string; microcopy?: string; messageLabel?: string; submitLabel: string; successMessage: string }
>;
---

{
  Object.entries(LEAD_FORM_FIELDS).map(([id, fieldKeys]) => {
    const copy = copyById[id];
    if (!copy) return null;

    return (
      <dialog id={`lead-dialog-${id}`} class="lead-dialog" data-lead-form-id={id}>
        <div class="relative w-full max-w-lg rounded-[12px] bg-paper p-8 shadow-card">
          <button
            type="button"
            aria-label="Close"
            class="absolute right-4 top-4 text-2xl leading-none text-muted hover:text-ink"
            data-close-lead-form
          >
            &times;
          </button>

          <h2 class="font-display text-[26px] font-bold text-ink">{copy.heading}</h2>
          {copy.microcopy && <p class="mt-2 text-sm text-muted">{copy.microcopy}</p>}

          <form class="lead-form mt-6 flex flex-col gap-4" data-lead-form-id={id} novalidate>
            {fieldKeys
              .filter((k) => k !== 'message')
              .map((key) => {
                const field = FIELD_DEFS[key];
                return (
                  <label class="flex flex-col gap-1 text-sm text-slate">
                    {field.label} {!field.required && <span class="text-muted">(optional)</span>}
                    <input
                      required={field.required}
                      name={field.key}
                      type={field.type as 'text' | 'email' | 'tel'}
                      class="rounded-[6px] border border-line bg-paper px-3 py-2 text-ink focus-visible:outline-2 focus-visible:outline-signal"
                    />
                  </label>
                );
              })}

            {fieldKeys.includes('message') && (
              <label class="flex flex-col gap-1 text-sm text-slate">
                {copy.messageLabel || 'Tell us more'}
                <textarea
                  name="message"
                  rows="3"
                  class="rounded-[6px] border border-line bg-paper px-3 py-2 text-ink focus-visible:outline-2 focus-visible:outline-signal"
                />
              </label>
            )}

            <p class="hidden text-sm text-ink success-message" role="status">
              {copy.successMessage}
            </p>

            <button
              type="submit"
              class="mt-2 inline-flex items-center justify-center rounded-[6px] bg-signal px-6 py-3 font-medium text-ink transition-colors duration-150 hover:bg-signal-deep hover:text-paper"
            >
              {copy.submitLabel}
            </button>
          </form>
        </div>
      </dialog>
    );
  })
}

<style>
  .lead-dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-height: 90vh;
    max-width: 90vw;
  }
  .lead-dialog::backdrop {
    background: rgba(22, 24, 29, 0.5);
  }
</style>

<script>
  import { submitForm } from '../lib/formSubmit';

  document.addEventListener('click', (event) => {
    const opener = (event.target as HTMLElement)?.closest('[data-open-lead-form]');
    if (opener) {
      event.preventDefault();
      const id = opener.getAttribute('data-open-lead-form');
      const dialog = document.getElementById(`lead-dialog-${id}`) as HTMLDialogElement | null;
      dialog?.showModal();
    }

    if ((event.target as HTMLElement)?.closest('[data-close-lead-form]')) {
      (event.target as HTMLElement).closest('dialog')?.close();
    }
  });

  document.querySelectorAll<HTMLDialogElement>('.lead-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });

  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const payload = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      const formType = form.dataset.leadFormId || 'unknown';

      try {
        await submitForm(formType, payload);
        form.querySelector('.success-message')?.classList.remove('hidden');
        form.reset();
      } catch (err) {
        console.error(`Lead form submission failed (${formType}):`, err);
      }
    });
  });
</script>
