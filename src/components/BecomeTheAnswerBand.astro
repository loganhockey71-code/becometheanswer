---
// Reusable "book promo" band per blueprint instruction: "Build it as a Component
// so you place one instance per page and edit it in one place." Used on Home,
// About, Become the Answer, and Work with Me.
//
// Every blueprint's book-band block defines the same three CTAs: primary
// ("Download the first chapter", labeled CTA5 in the source docs, but that
// CTA's official field set is a masterclass-booking form with phone/message
// fields, which doesn't fit an instant chapter download — implemented here
// as the lightweight "download-chapter" lead form instead), secondary
// ("Pre-order the book", CTA3-shaped), and a third text link ("Let's talk
// about your brand", CTA7 / consultancy).
import Button from './Button.astro';

interface Props {
  description: string;
  microPoints: string[];
  primaryCtaLabel: string;
  secondaryCtaLabel?: string;
  tertiaryCtaLabel?: string;
  bg?: 'cloud' | 'ink';
  id?: string;
}

const {
  description,
  microPoints,
  primaryCtaLabel,
  secondaryCtaLabel,
  tertiaryCtaLabel,
  bg = 'ink',
  id,
} = Astro.props;

const isInk = bg === 'ink';
---

<section id={id} class:list={['py-14 md:py-24', isInk ? 'bg-ink text-paper' : 'bg-cloud text-ink']}>
  <div class="mx-auto grid w-full max-w-[1120px] grid-cols-1 items-center gap-10 px-6 md:grid-cols-2">
    <div
      class:list={[
        'flex aspect-[3/4] w-full max-w-[280px] items-center justify-center rounded-[12px] border',
        isInk ? 'border-slate' : 'border-line',
      ]}
      role="img"
      aria-label="Become the Answer book cover placeholder — final cover to be supplied"
    >
      <span class:list={['text-xs uppercase tracking-[0.08em]', isInk ? 'text-muted' : 'text-muted']}>
        Book cover
      </span>
    </div>

    <div>
      <h2 class="font-display text-3xl font-bold">
        Become <span class="text-signal">the Answer</span>
      </h2>
      <p class:list={['mt-4 max-w-prose text-lg', isInk ? 'text-line' : 'text-slate']}>
        {description}
      </p>
      <ul class="mt-6 flex flex-wrap gap-x-2 gap-y-2 text-sm">
        {
          microPoints.map((point, i) => (
            <>
              <li class={isInk ? 'text-paper' : 'text-ink'}>{point}</li>
              {i < microPoints.length - 1 && <li class="text-signal" aria-hidden="true">·</li>}
            </>
          ))
        }
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button variant="primary" openLeadForm="download-chapter">{primaryCtaLabel}</Button>
        {secondaryCtaLabel && (
          <Button variant={isInk ? 'ghost-invert' : 'secondary'} openLeadForm="preorder">
            {secondaryCtaLabel}
          </Button>
        )}
        {tertiaryCtaLabel && (
          <Button variant="link" openLeadForm="consultancy">
            {tertiaryCtaLabel}
          </Button>
        )}
      </div>
    </div>
  </div>
</section>
