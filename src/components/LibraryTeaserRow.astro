---
interface Item {
  title: string;
  description: string;
}
interface Props {
  items: Item[];
  href: string;
}
const { items, href } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
  {
    items.map((item) => (
      <a
        href={href}
        class="flex flex-col rounded-[12px] border border-line bg-paper p-6 transition-colors hover:border-signal"
      >
        <h3 class="font-display text-lg font-bold text-ink">{item.title}</h3>
        <p class="mt-2 text-sm text-slate">{item.description}</p>
      </a>
    ))
  }
</div>
