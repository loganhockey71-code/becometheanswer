---
interface Row {
  label: string;
  seo: string;
  aeo: string;
}
interface Props {
  rows: Row[];
  seoLabel?: string;
  aeoLabel?: string;
}
const { rows, seoLabel = 'SEO', aeoLabel = 'AEO' } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="w-full min-w-[480px] border-collapse text-left">
    <thead>
      <tr class="border-b border-line">
        <th class="py-3 pr-4 text-sm font-semibold uppercase tracking-[0.04em] text-muted"></th>
        <th class="py-3 pr-4 font-display text-lg font-bold text-slate">{seoLabel}</th>
        <th class="py-3 font-display text-lg font-bold text-signal-deep">{aeoLabel}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-b border-line align-top">
            <th scope="row" class="py-4 pr-4 text-sm font-semibold text-ink">
              {row.label}
            </th>
            <td class="py-4 pr-4 text-slate">{row.seo}</td>
            <td class="py-4 font-medium text-ink">{row.aeo}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
