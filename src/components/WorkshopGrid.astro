---
interface Workshop {
  number: string;
  title: string;
  description: string;
  leavesWith: string;
}
interface Props {
  workshops: Workshop[];
}
const { workshops } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
  {
    workshops.map((workshop) => (
      <div class="flex flex-col rounded-[12px] border border-line bg-paper p-6">
        <span class="font-display text-2xl font-bold text-signal">{workshop.number}</span>
        <h3 class="mt-2 font-display text-lg font-bold text-ink">{workshop.title}</h3>
        <p class="mt-2 text-sm text-slate">{workshop.description}</p>
        <p class="mt-3 text-sm text-muted">
          <span class="font-semibold text-ink">Leaves with: </span>
          {workshop.leavesWith}
        </p>
      </div>
    ))
  }
</div>
