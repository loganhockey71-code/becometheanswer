---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import page from '../../content/pages/terms-of-service.json';
import { breadcrumbSchema } from '../lib/seo';

const { seo, eyebrow, heading, lead, lastUpdated, intro, sections } = page;

const siteUrl = Astro.site!.toString();
const jsonLd = [
  breadcrumbSchema(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'Terms of Service', path: '/terms-of-service' },
  ]),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <Section bg="paper" padding="top-only">
    <Breadcrumbs items={[{ name: 'Terms of Service' }]} />
    <Eyebrow class="mt-4">{eyebrow}</Eyebrow>
    <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] text-ink md:text-5xl">{heading}</h1>
    <p class="mt-4 text-lg text-slate">{lead}</p>
    <p class="mt-2 text-sm text-muted">Last updated: {lastUpdated}</p>
  </Section>

  <Section bg="paper" padding="bottom-only">
    <div class="mx-auto max-w-2xl">
      <p class="text-slate">{intro}</p>

      <div class="mt-10 flex flex-col gap-10">
        {
          sections.map((section: { heading: string; paragraphs: string[] }) => (
            <div>
              <h2 class="font-display text-xl font-bold text-ink">{section.heading}</h2>
              <div class="mt-3 flex flex-col gap-3 text-slate">
                {section.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-12 border-t border-line pt-6 text-xs text-muted">
        These Terms are a general starting point and do not constitute legal advice. They should be reviewed by
        counsel familiar with your jurisdiction before you rely on them.
      </p>
    </div>
  </Section>
</BaseLayout>
