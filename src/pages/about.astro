---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import BecomeTheAnswerBand from '../components/BecomeTheAnswerBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import about from '../../content/pages/about.json';

const { seo, eyebrow, headline, lead, connectLine, whatIBelieve, whatIDo, principles, team, bookBand, faq, closingCta } =
  about;
---

<BaseLayout title={seo.title} description={seo.description}>
  <!-- Header + lead -->
  <Section bg="paper" padding="top-only">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold leading-[1.05] text-ink md:text-5xl">
      {headline}
    </h1>

    <div class="mt-12 grid grid-cols-1 items-start gap-10 md:grid-cols-[280px_1fr]">
      <div
        class="flex aspect-square w-full max-w-[280px] items-center justify-center rounded-[12px] border border-line bg-cloud"
        role="img"
        aria-label="Bjorn Vandemeulebroucke headshot placeholder — final photo to be supplied"
      >
        <span class="text-xs uppercase tracking-[0.08em] text-muted">Headshot</span>
      </div>

      <div>
        <p class="max-w-prose text-lg text-slate md:text-xl">{lead}</p>
        <Button variant="link" openLeadForm="connect" class="mt-6 inline-block text-base">
          {connectLine}
        </Button>
      </div>
    </div>
  </Section>

  <!-- What I believe -->
  <Section bg="cloud">
    <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{whatIBelieve.heading}</h2>
    <div class="mt-6 flex max-w-3xl flex-col gap-5 text-lg text-slate">
      {whatIBelieve.paragraphs.map((p: string) => <p>{p}</p>)}
    </div>
  </Section>

  <!-- What I actually do -->
  <Section bg="paper">
    <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{whatIDo.heading}</h2>
    <p class="mt-4 text-lg text-slate">{whatIDo.intro}</p>
    <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        whatIDo.items.map((item: { title: string; description: string }) => (
          <div>
            <h3 class="font-display text-xl font-bold text-ink">{item.title}</h3>
            <p class="mt-3 text-sm text-slate">{item.description}</p>
            <Button variant="link" href="/become-the-answer" class="mt-4 inline-block text-sm">
              {whatIDo.ctaLabel}
            </Button>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Principles -->
  <Section bg="cloud">
    <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{principles.heading}</h2>
    <p class="mt-4 max-w-prose text-lg text-slate">{principles.intro}</p>
    <ul class="mt-10 flex flex-col divide-y divide-line border-y border-line">
      {
        principles.items.map((item: { title: string; description: string }) => (
          <li class="flex flex-col gap-1 py-5 sm:flex-row sm:gap-6">
            <span class="font-display text-lg font-bold text-ink sm:w-64 sm:shrink-0">{item.title}</span>
            <span class="text-slate">{item.description}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Team (fallback single line per blueprint UX note) -->
  <Section bg="paper" padding="bottom-only">
    <p class="text-center text-sm text-muted">{team.fallbackLine}</p>
  </Section>

  <!-- Become the Answer book band -->
  <BecomeTheAnswerBand
    description={bookBand.description}
    microPoints={bookBand.microPoints}
    primaryCtaLabel={bookBand.primaryCtaLabel}
    secondaryCtaLabel={bookBand.secondaryCtaLabel}
    tertiaryCtaLabel={bookBand.tertiaryCtaLabel}
    bg="cloud"
  />

  <!-- FAQ -->
  <Section bg="paper">
    <FaqAccordion heading={faq.heading} items={faq.items} />
  </Section>

  <!-- Closing CTA -->
  <Section bg="ink">
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <p class="max-w-xl text-lg text-paper md:text-xl">{closingCta.line}</p>
      <Button variant="primary" openRegisterForm>{closingCta.ctaLabel}</Button>
    </div>
  </Section>
</BaseLayout>
