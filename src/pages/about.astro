---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import BecomeTheAnswerBand from '../components/BecomeTheAnswerBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import about from '../../content/pages/about.json';
import { personSchema, faqPageSchema, breadcrumbSchema } from '../lib/seo';
import bjornHeadshot from '../assets/brand/bjorn-headshot.png';
import { Image } from 'astro:assets';

const { seo, eyebrow, headline, lead, connectLine, whatIBelieve, whatIDo, principles, bookBand, faq, closingCta } =
  about;

const siteUrl = Astro.site!.toString();
const jsonLd = [
  personSchema(siteUrl),
  faqPageSchema(faq.items),
  breadcrumbSchema(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <!-- Header + lead -->
  <Section bg="paper" padding="top-only" containerClass="pb-20 md:pb-28">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="mt-3 max-w-3xl font-display text-[38px] font-bold leading-[1.05] text-ink md:text-[50px]">
      {headline}
    </h1>

    <div class="mt-12 grid grid-cols-1 items-start gap-10 md:grid-cols-[280px_1fr]">
      <Image
        src={bjornHeadshot}
        alt="Bjorn Vandemeulebroucke, author of Become the Answer and creator of the AI Answer Index"
        class="aspect-square w-full max-w-[280px] rounded-[12px] border border-line object-cover object-top"
        loading="eager"
        widths={[280, 560]}
        sizes="280px"
      />

      <div>
        <p class="max-w-prose text-lg text-slate md:text-xl">{lead}</p>
        <Button variant="link" openLeadForm="connect" class="mt-6 inline-block text-base">
          {connectLine}
        </Button>
      </div>
    </div>
  </Section>

  <!-- What I believe -->
  <Section bg="cloud">
    <h2 class="font-display text-[32px] font-bold text-ink md:text-[38px]">{whatIBelieve.heading}</h2>
    <div class="mt-6 flex max-w-3xl flex-col gap-5 text-lg text-slate">
      {whatIBelieve.paragraphs.map((p: string) => <p>{p}</p>)}
    </div>
  </Section>

  <!-- What I actually do -->
  <Section bg="paper">
    <h2 class="font-display text-[32px] font-bold text-ink md:text-[38px]">{whatIDo.heading}</h2>
    <p class="mt-4 text-lg text-slate">{whatIDo.intro}</p>
    <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        whatIDo.items.map((item: { title: string; description: string }) => (
          <div class="flex h-full flex-col">
            <h3 class="font-display text-[22px] font-bold text-ink">{item.title}</h3>
            <p class="mt-3 flex-1 text-sm text-slate">{item.description}</p>
            <Button variant="link" href="/become-the-answer" class="mt-4 inline-block self-start text-sm">
              {whatIDo.ctaLabel}
            </Button>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Principles -->
  <Section bg="cloud">
    <h2 class="font-display text-[32px] font-bold text-ink md:text-[38px]">{principles.heading}</h2>
    <p class="mt-4 max-w-prose text-lg text-slate">{principles.intro}</p>
    <ul class="mt-10 flex flex-col divide-y divide-line border-y border-line">
      {
        principles.items.map((item: { title: string; description: string }) => (
          <li class="flex flex-col gap-1 py-5 sm:flex-row sm:gap-6">
            <span class="font-display text-lg font-bold text-ink sm:w-64 sm:shrink-0">{item.title}</span>
            <span class="text-slate">{item.description}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Become the Answer book band -->
  <BecomeTheAnswerBand
    description={bookBand.description}
    microPoints={bookBand.microPoints}
    primaryCtaLabel={bookBand.primaryCtaLabel}
    secondaryCtaLabel={bookBand.secondaryCtaLabel}
    tertiaryCtaLabel={bookBand.tertiaryCtaLabel}
    bg="ink"
  />

  <!-- FAQ -->
  <Section bg="paper">
    <FaqAccordion heading={faq.heading} items={faq.items} />
  </Section>

  <!-- Closing CTA -->
  <Section bg="ink">
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <p class="max-w-xl text-lg text-paper md:text-xl">{closingCta.line}</p>
      <Button variant="primary" openRegisterForm>{closingCta.ctaLabel}</Button>
    </div>
  </Section>
</BaseLayout>
