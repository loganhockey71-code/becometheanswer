---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import ZmotDiagram from '../components/ZmotDiagram.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import LibraryTeaserRow from '../components/LibraryTeaserRow.astro';
import BecomeTheAnswerBand from '../components/BecomeTheAnswerBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import page from '../../content/pages/become-the-answer.json';

const {
  seo,
  hero,
  stakes,
  operatingSystem,
  whyMe,
  costOfWaiting,
  beyondTheScore,
  library,
  bookBand,
  faq,
} = page;

const ebookStripeLink = 'https://buy.stripe.com/test_14A5kF0B64hQ6d54cg4Ni00';
---

<BaseLayout title={seo.title} description={seo.description}>
  <!-- Hero -->
  <Section bg="paper" padding="top-only">
    <Eyebrow>{hero.eyebrow}</Eyebrow>
    <h1 class="mt-3 max-w-3xl font-display text-4xl font-bold leading-[1.05] text-ink md:text-5xl">
      {hero.headline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate md:text-xl">{hero.subhead}</p>
    <div class="mt-10">
      <ZmotDiagram />
    </div>
    <div class="mt-8">
      <Button variant="primary" openRegisterForm>{hero.ctaLabel}</Button>
    </div>
  </Section>

  <!-- What is at stake -->
  <Section bg="cloud">
    <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{stakes.heading}</h2>
    <p class="mt-4 max-w-prose text-lg text-slate">{stakes.body}</p>

    <div class="mt-12 flex flex-col divide-y divide-line border-y border-line">
      <div class="flex flex-col gap-3 py-8">
        <h3 class="font-display text-xl font-bold text-ink">{stakes.tool1.heading}</h3>
        <p class="text-xs uppercase tracking-[0.04em] text-muted">{stakes.tool1.microcopy}</p>
        <p class="max-w-prose text-slate">{stakes.tool1.body}</p>
        <div class="mt-2">
          <Button variant="primary" openRegisterForm>{stakes.tool1.ctaLabel}</Button>
        </div>
      </div>

      <div class="flex flex-col gap-3 py-8">
        <h3 class="font-display text-xl font-bold text-ink">{stakes.tool2.heading}</h3>
        <p class="max-w-prose text-slate">{stakes.tool2.subhead}</p>
        <div class="mt-2">
          <Button variant="primary" openRegisterForm>{stakes.tool2.ctaLabel}</Button>
        </div>
      </div>
    </div>
  </Section>

  <!-- New operating system -->
  <Section bg="paper">
    <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{operatingSystem.heading}</h2>
    <p class="mt-4 max-w-prose text-lg text-slate">{operatingSystem.body}</p>

    <h3 class="mt-8 font-display text-xl font-bold text-ink">{operatingSystem.subheading}</h3>
    <p class="mt-3 max-w-prose text-slate">{operatingSystem.subheadingBody}</p>

    <div class="mt-8">
      <ComparisonTable rows={operatingSystem.comparisonRows} />
    </div>

    <p class="mt-6 max-w-prose text-sm italic text-slate">
      {operatingSystem.proofLine}
      {' '}
      <span class="text-muted">({operatingSystem.proofSource})</span>
    </p>

    <div class="mt-6">
      <Button variant="ghost" href={ebookStripeLink}>{operatingSystem.ctaLabel}</Button>
    </div>
  </Section>

  <!-- Why me, and how -->
  <Section bg="cloud">
    <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{whyMe.heading}</h2>
    <p class="mt-4 max-w-prose text-lg text-slate">{whyMe.body}</p>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        whyMe.ways.map((way: { title: string; description: string; ctaLabel: string; ctaHref?: string }) => (
          <div class="flex flex-col rounded-[12px] border border-line bg-paper p-6">
            <h3 class="font-display text-lg font-bold text-ink">{way.title}</h3>
            <p class="mt-2 text-sm text-slate">{way.description}</p>
            {way.ctaHref ? (
              <Button variant="link" href={way.ctaHref} class="mt-4 self-start text-sm">
                {way.ctaLabel}
              </Button>
            ) : (
              <Button variant="link" openRegisterForm class="mt-4 self-start text-sm">
                {way.ctaLabel}
              </Button>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Cost of waiting -->
  <Section bg="ink">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold text-paper md:text-4xl">{costOfWaiting.heading}</h2>
      <p class="mt-6 text-lg text-line">{costOfWaiting.body}</p>
      <div class="mt-8">
        <Button variant="primary" openRegisterForm>{costOfWaiting.ctaLabel}</Button>
      </div>
      <p class="mt-8 font-display text-lg font-bold text-signal">{costOfWaiting.quotableLine}</p>
    </div>
  </Section>

  <!-- Beyond the score -->
  <Section bg="paper">
    <div class="mx-auto max-w-2xl border-l-2 border-signal pl-8 text-left">
      <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{beyondTheScore.heading}</h2>
      <p class="mt-6 text-lg text-slate">{beyondTheScore.subhead}</p>
      <p class="mt-4 text-slate">{beyondTheScore.body}</p>
      <div class="mt-8">
        <Button variant="secondary" openRegisterForm>{beyondTheScore.ctaLabel}</Button>
      </div>
      <p class="mt-8 font-display text-lg font-bold text-signal-deep">{beyondTheScore.quotableLine}</p>
    </div>
  </Section>

  <!-- Our Library -->
  <Section bg="cloud">
    <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{library.heading}</h2>
    <p class="mt-4 max-w-prose text-lg text-slate">{library.intro}</p>
    <div class="mt-10">
      <LibraryTeaserRow items={library.items} href="/library" />
    </div>
  </Section>

  <!-- Become the Answer book band -->
  <BecomeTheAnswerBand
    id="book"
    description={bookBand.description}
    microPoints={bookBand.microPoints}
    primaryCtaLabel={bookBand.primaryCtaLabel}
    secondaryCtaLabel={bookBand.secondaryCtaLabel}
    tertiaryCtaLabel={bookBand.tertiaryCtaLabel}
    bg="ink"
  />

  <!-- FAQ -->
  <Section bg="paper">
    <FaqAccordion heading={faq.heading} items={faq.items} />
  </Section>
</BaseLayout>
