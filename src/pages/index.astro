---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import StatBar from '../components/StatBar.astro';
import DigitalShelfChart from '../components/DigitalShelfChart.astro';
import OfferRow from '../components/OfferRow.astro';
import StatCard from '../components/StatCard.astro';
import ToolTable from '../components/ToolTable.astro';
import EquityTable from '../components/EquityTable.astro';
import BecomeTheAnswerBand from '../components/BecomeTheAnswerBand.astro';
import aiAnswerIndexImage from '../assets/brand/ai-answer-index.png';
import { Image } from 'astro:assets';
import home from '../../content/pages/home.json';

const {
  seo,
  hero,
  statBar,
  bigIdea,
  digitalShelf,
  offerRow,
  proofStats,
  toolsTable,
  equityTable,
  authority,
  closingCta,
  bookBand,
} = home;
---

<BaseLayout title={seo.title} description={seo.description}>
  <!-- Hero: clean, no standalone visual per feedback — a full-size background
       photo was the alternative offered, but no real photography asset exists
       in the repo to use for one, so this stays a clean typographic hero. -->
  <Section bg="paper" padding="top-only">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="font-display text-[38px] font-bold leading-[1.05] text-ink md:text-[62px]">
        {hero.headline}
      </h1>
      <p class="mx-auto mt-6 max-w-prose text-lg text-slate md:text-xl">
        {hero.subhead}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <Button variant="primary" openRegisterForm class="text-base">
          {hero.ctaLabel}
        </Button>
        <Button variant="secondary" href={hero.storyLinkHref} class="text-base">
          {hero.storyLinkLabel}
        </Button>
      </div>
    </div>
  </Section>

  <!-- Credibility stats bar -->
  <Container class="pb-14 pt-10 md:pb-24 md:pt-16">
    <StatBar stats={statBar.stats} />
  </Container>

  <!-- Big idea -->
  <Section bg="cloud">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-[32px] font-bold text-ink md:text-[38px]">{bigIdea.title}</h2>
      <p class="mt-6 text-lg text-slate">{bigIdea.subtitle}</p>
      <div class="mt-8">
        <Button variant="secondary" href={bigIdea.ctaHref}>{bigIdea.ctaLabel}</Button>
      </div>
    </div>
  </Section>

  <!-- Impact on the digital shelf -->
  <Section bg="paper">
    <DigitalShelfChart
      eyebrow={digitalShelf.eyebrow}
      heading={digitalShelf.heading}
      intro={digitalShelf.intro}
      stages={digitalShelf.stages}
      riskHeading={digitalShelf.riskHeading}
      riskBody={digitalShelf.riskBody}
      source={digitalShelf.source}
    />
  </Section>

  <!-- Build your spot on the AI shelf -->
  <Section bg="cloud">
    <h2 class="font-display text-[32px] font-bold text-ink md:text-[38px]">
      Build your spot on the AI shelf
    </h2>
    <div class="mt-10">
      <OfferRow items={offerRow.items} featuredIndex={1} />
    </div>
  </Section>

  <!-- Proof stats -->
  <Section bg="paper">
    <h2 class="font-display text-[32px] font-bold text-ink md:text-[38px]">{proofStats.heading}</h2>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        proofStats.items.map((item: any) => (
          <StatCard
            stat={item.stat}
            context={item.context}
            sourceLabel={item.sourceLabel}
            sourceUrl={item.sourceUrl}
          />
        ))
      }
    </div>
    <div class="mt-8">
      <Button variant="ghost" openLeadForm="downloadReport">{proofStats.ctaLabel}</Button>
    </div>
  </Section>

  <!-- Curious where you stand: tools table -->
  <Section bg="cloud">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-[minmax(0,380px)_1fr]">
      <Image
        src={aiAnswerIndexImage}
        alt="The AI Answer Index score card, showing an overall score with Share of Answer, Share of Recommendation and the Structure, Credibility and Identity pillar audits"
        class="w-full rounded-[12px] border border-line"
        loading="lazy"
        widths={[400, 700]}
        sizes="(min-width: 768px) 380px, 100vw"
      />
      <ToolTable
        eyebrow={toolsTable.eyebrow}
        heading={toolsTable.heading}
        subhead={toolsTable.subhead}
        tools={toolsTable.tools}
        ctaLabel={toolsTable.ctaLabel}
        microcopy={toolsTable.microcopy}
        honestyNote={toolsTable.honestyNote}
      />
    </div>
    <p class="mt-6">
      <a href="/free-analysis" class="text-sm text-signal-deep underline underline-offset-4 hover:text-signal">
        Read the full breakdown of what's in the free analysis &rarr;
      </a>
    </p>
  </Section>

  <!-- Answer Equity -->
  <Section bg="paper">
    <EquityTable heading={equityTable.heading} dimensions={equityTable.dimensions} />
  </Section>

  <!-- Closing CTA -->
  <Section bg="ink">
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <p class="max-w-xl font-display text-2xl font-bold text-paper md:text-3xl">
        {closingCta.line}
      </p>
      <Button variant="primary" href={closingCta.ctaHref}>{closingCta.ctaLabel}</Button>
    </div>
    {authority?.line && <p class="mt-8 max-w-2xl text-sm text-line">{authority.line}</p>}
  </Section>

  <!-- Become the Answer book band -->
  <BecomeTheAnswerBand
    description={bookBand.description}
    microPoints={bookBand.microPoints}
    primaryCtaLabel={bookBand.primaryCtaLabel}
    secondaryCtaLabel={bookBand.secondaryCtaLabel}
    tertiaryCtaLabel={bookBand.tertiaryCtaLabel}
    bg="ink"
  />
</BaseLayout>
