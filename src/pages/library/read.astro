---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import LibraryTabs from '../../components/LibraryTabs.astro';
import LibraryCard from '../../components/LibraryCard.astro';
import LibraryFilterBar from '../../components/LibraryFilterBar.astro';
import { getLibraryItems, estimateReadTime } from '../../lib/library';
import libraryContent from '../../../content/pages/library.json';

const { read } = libraryContent;
const items = await getLibraryItems('read');
---

<BaseLayout title={read.seo.title} description={read.seo.description}>
  <Section bg="paper" padding="top-only">
    <h1 class="font-display text-4xl font-bold text-ink md:text-5xl">{read.heading}</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate">{read.intro}</p>
    <div class="mt-8">
      <LibraryTabs active="read" />
    </div>

    <div class="mt-12">
      {
        items.length > 0 ? (
          <>
            <LibraryFilterBar searchPlaceholder={read.searchPlaceholder} emptyStateText={read.emptyState} />
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
              {items.map((item) => (
                <LibraryCard item={item} ctaLabel="Read" readTime={estimateReadTime(item.body || '')} />
              ))}
            </div>
          </>
        ) : (
          // No filter/search UI when the collection itself is empty — there's
          // nothing yet to filter, so showing those controls would be confusing.
          <p class="py-16 text-center text-slate">{read.emptyState}</p>
        )
      }
    </div>
  </Section>
</BaseLayout>
