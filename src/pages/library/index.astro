---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import LibraryTabs from '../../components/LibraryTabs.astro';
import LibraryCard from '../../components/LibraryCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getLibraryItems, estimateReadTime } from '../../lib/library';
import libraryContent from '../../../content/pages/library.json';

const { seo, eyebrow, hero, featured, buckets, faq } = libraryContent;

const allItems = await getLibraryItems();
const featuredItems = allItems.filter((item) => item.data.featured);
---

<BaseLayout title={seo.title} description={seo.description}>
  <!-- Hero -->
  <Section bg="paper" padding="top-only">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="mt-3 max-w-2xl font-display text-4xl font-bold leading-[1.05] text-ink md:text-5xl">
      {hero.heading}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate md:text-xl">{hero.subhead}</p>
    <div class="mt-8">
      <LibraryTabs active="all" />
    </div>
  </Section>

  <!-- Featured (only renders when at least one item is marked featured) -->
  {
    featuredItems.length > 0 && (
      <Section bg="cloud">
        <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{featured.heading}</h2>
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
          {featuredItems.map((item) => (
            <LibraryCard
              item={item}
              readTime={item.data.type === 'read' ? estimateReadTime(item.body || '') : undefined}
              ctaLabel={item.data.type === 'read' ? 'Read' : item.data.type === 'watch' ? 'Watch' : 'Listen'}
            />
          ))}
        </div>
      </Section>
    )
  }

  <!-- Our AEO Library structure (five buckets) -->
  <Section bg={featuredItems.length > 0 ? 'paper' : 'cloud'}>
    <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{buckets.heading}</h2>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        buckets.items.map((bucket: { name: string; description: string; ctaLabel: string; ctaFormType?: string }) => (
          <div class="flex flex-col rounded-[12px] border border-line bg-paper p-6">
            <h3 class="font-display text-lg font-bold text-ink">{bucket.name}</h3>
            <p class="mt-2 flex-1 text-sm text-slate">{bucket.description}</p>
            <div class="mt-4 flex flex-wrap items-center gap-4">
              <a
                href={`/library/read?bucket=${encodeURIComponent(bucket.name)}`}
                class="text-sm text-signal-deep underline underline-offset-4 hover:text-signal"
              >
                Explore
              </a>
              {bucket.ctaFormType ? (
                <Button variant="link" openLeadForm={bucket.ctaFormType} class="text-sm">
                  {bucket.ctaLabel}
                </Button>
              ) : (
                <Button variant="link" openRegisterForm class="text-sm">
                  {bucket.ctaLabel}
                </Button>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Watch / Listen teasers -->
  <Section bg={featuredItems.length > 0 ? 'cloud' : 'paper'}>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <a
        href="/library/watch"
        class="flex flex-col rounded-[12px] border border-line bg-paper p-8 transition-colors hover:border-signal"
      >
        <h3 class="font-display text-xl font-bold text-ink">Watch</h3>
        <p class="mt-2 text-sm text-slate">Keynotes, clips and explainers on where search is going.</p>
        <span class="mt-4 text-sm font-medium text-signal-deep">See all Watch &rarr;</span>
      </a>
      <a
        href="/library/listen"
        class="flex flex-col rounded-[12px] border border-line bg-paper p-8 transition-colors hover:border-signal"
      >
        <h3 class="font-display text-xl font-bold text-ink">Listen</h3>
        <p class="mt-2 text-sm text-slate">Podcast appearances and conversations on AI search.</p>
        <span class="mt-4 text-sm font-medium text-signal-deep">See all Listen &rarr;</span>
      </a>
    </div>
  </Section>

  <!-- FAQ -->
  <Section bg={featuredItems.length > 0 ? 'paper' : 'cloud'}>
    <FaqAccordion heading={faq.heading} items={faq.items} />
  </Section>
</BaseLayout>
