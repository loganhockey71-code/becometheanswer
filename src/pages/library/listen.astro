---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import LibraryTabs from '../../components/LibraryTabs.astro';
import LibraryCard from '../../components/LibraryCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getLibraryItems } from '../../lib/library';
import libraryContent from '../../../content/pages/library.json';
import { breadcrumbSchema } from '../../lib/seo';

const { listen } = libraryContent;
const items = await getLibraryItems('listen');

const siteUrl = Astro.site!.toString();
const jsonLd = [
  breadcrumbSchema(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'Library', path: '/library' },
    { name: 'Listen', path: '/library/listen' },
  ]),
];
---

<BaseLayout title={listen.seo.title} description={listen.seo.description} jsonLd={jsonLd}>
  <Section bg="paper" padding="top-only">
    <Breadcrumbs items={[{ name: 'Library', href: '/library' }, { name: 'Listen' }]} />
    <h1 class="mt-4 font-display text-[38px] font-bold text-ink md:text-[50px]">{listen.heading}</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate">{listen.intro}</p>
    <div class="mt-8">
      <LibraryTabs active="listen" />
    </div>

    {
      items.length > 0 ? (
        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
          {items.map((item) => (
            <LibraryCard item={item} ctaLabel={listen.cardCtaLabel} />
          ))}
        </div>
      ) : (
        <p class="mt-16 text-center text-slate">{listen.emptyState}</p>
      )
    }
  </Section>
</BaseLayout>
